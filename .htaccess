# =========================================================
# Zatoka Cydrowa — przekierowania 301 ze starych adresów WordPress
# na nową strukturę statycznej strony.
#
# Adresy poniżej zostały zweryfikowane bezpośrednio na żywym WordPressie
# (plik llms.txt na zatokacydrowa.pl) — to realne, zaindeksowane URL-e,
# nie zgadywane.
#
# WAŻNE: ten plik ma trafić do katalogu GŁÓWNEGO domeny
# (public_html/) DOPIERO w momencie przełączenia domeny głównej
# zatokacydrowa.pl na nową wersję statyczną. Dopóki testujecie
# na nowa.zatokacydrowa.pl, NIE wgrywajcie tego pliku tam, bo
# subdomena nie ma tych starych adresów WordPress do przekierowania.
# =========================================================

RewriteEngine On

# --- Apartamenty całoroczne ---
Redirect 301 /osmioosobowy/ /apartamenty/apartament-1.html
Redirect 301 /piecioosobowy/ /apartamenty/apartament-2.html
Redirect 301 /siedmioosobowy/ /apartamenty/apartament-3.html
Redirect 301 /czteroosobowy/ /apartamenty/apartament-4.html

# --- Apartamenty letnie ---
# NE = nie koduj '#' jako %23 (inaczej kotwica przestaje działać)
RewriteRule ^apartamenty-letnie/?$ /#apartamenty-letnie [R=301,L,NE]
RewriteRule ^apartamenty/?$ /#apartamenty [R=301,L,NE]
RewriteRule ^en/apartamenty-letnie/?$ /en/#apartamenty-letnie [R=301,L,NE]
RewriteRule ^en/apartamenty/?$ /en/#apartamenty [R=301,L,NE]
Redirect 301 /apa_letni_dwupokojowy/ /apartamenty-letnie/apartament-letni-1.html
Redirect 301 /apa_letni_dwuosobowy/ /apartamenty-letnie/apartament-letni-2.html
Redirect 301 /apa_czarno_bialy/ /apartamenty-letnie/apartament-letni-3.html
Redirect 301 /apa_letni_czteroosobowy/ /apartamenty-letnie/apartament-letni-4.html

# --- Mieszkania letnie ---
Redirect 301 /mieszkania_letnie/ /mieszkania-letnie.html

# --- Pokoje (ogólny przegląd) ---
Redirect 301 /pokoje/ /#apartamenty

# --- Dzieci / atrakcje na miejscu ---
Redirect 301 /sala-zabaw/ /dla-dzieci.html
Redirect 301 /zatoczka-cydrowa/ /dla-dzieci.html
Redirect 301 /atrakcje-w-zatoce-cydrowej/ /#wellness
Redirect 301 /komora-hiperbaryczna-w-zatoce-cydrowej/ /#wellness
Redirect 301 /solarium-w-zatoce-cydrowej/ /#wellness
Redirect 301 /sauna/ /#wellness

# --- Okolica / atrakcje w okolicy ---
Redirect 301 /atrakcje-okolice/ /#okolica

# --- Kontakt / rezerwacje / polityka ---
Redirect 301 /kontakt/ /kontakt.html
Redirect 301 /rezerwacje/ /kontakt.html
Redirect 301 /polityka-prywatnosci/ /polityka-prywatnosci.html

# --- Wpisy blogowe o okolicy (Stegna, Mierzeja Wiślana) ---
# Nowa strona nie ma bloga — przekierowanie do sekcji okolicy zamiast 404.
Redirect 301 /polomarket-stegna/ /#okolica
Redirect 301 /dino-stegna/ /#okolica
Redirect 301 /kosciol-najswietszego-serca-pana-jezusa-w-stegnie/ /#okolica
Redirect 301 /muzeum-stutthof/ /#okolica
Redirect 301 /zimowe-morsowanie/ /#okolica
Redirect 301 /szlak-rowerowy/ /#okolica
Redirect 301 /bursztynowa-komnata/ /#okolica
Redirect 301 /bon-turystyczny/ /#okolica
Redirect 301 /podziel-sie/ /

# --- Jeden kanoniczny adres strony głównej: /index.html -> / (oraz /en/index.html -> /en/) ---
# THE_REQUEST sprawdza tylko adres wpisany przez klienta, więc wewnętrzne
# DirectoryIndex (/ -> index.html) nie powoduje pętli.
RewriteCond %{THE_REQUEST} \s/+(en/)?index\.html[\s?]
RewriteRule ^(en/)?index\.html$ /$1 [R=301,L]

# HTTPS jest już wymuszany na poziomie panelu Hostingera
# (is_https_redirect_enabled: true) — nie duplikujemy tej reguły tutaj,
# żeby nie tworzyć podwójnego/pętlącego się przekierowania.

# =========================================================
# Kodowanie znaków — llms.txt, pricing.md, sitemap itd. w UTF-8
# (bez tego polskie znaki w plikach .txt/.md mogą trafić do
# botów AI jako "krzaczki")
# =========================================================
AddDefaultCharset UTF-8
AddType text/markdown .md
AddCharset UTF-8 .txt .md .xml .html .css .js .svg

# =========================================================
# Kompresja (GZIP/Brotli) — mniejszy transfer HTML/CSS/JS/SVG
# =========================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/markdown text/xml application/xml application/xhtml+xml text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown text/xml application/xml application/xhtml+xml text/javascript application/javascript application/json image/svg+xml
</IfModule>

# =========================================================
# Cache przeglądarki — obrazy/webp długo, HTML krótko (żeby
# zmiany treści były widoczne od razu, a zdjęcia i style nie
# były pobierane ponownie przy każdej wizycie)
# =========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Podstawowe nagłówki bezpieczeństwa (pomagają też w audytach SEO/PageSpeed)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Content-Security-Policy — strona jest statyczna, jedyne zewnętrzne
  # zasoby to Google Fonts (style/czcionki) i osadzona mapa Google Maps.
  # script-src wymaga 'unsafe-inline' z powodu handlerów onclick= używanych
  # w lightboxie (gallery); brak innych inline style="" w kodzie, więc
  # style-src nie potrzebuje 'unsafe-inline'.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
