# =========================================================
# Zatoka Cydrowa — przekierowania 301 ze starych adresów WordPress
# na nową strukturę statycznej strony.
#
# Adresy poniżej zostały zweryfikowane bezpośrednio na żywym WordPressie
# (plik llms.txt na zatokacydrowa.pl) — to realne, zaindeksowane URL-e,
# nie zgadywane.
#
# WAŻNE: ten plik ma trafić do katalogu GŁÓWNEGO domeny
# (public_html/) DOPIERO w momencie przełączenia domeny głównej
# zatokacydrowa.pl na nową wersję statyczną. Dopóki testujecie
# na nowa.zatokacydrowa.pl, NIE wgrywajcie tego pliku tam, bo
# subdomena nie ma tych starych adresów WordPress do przekierowania.
# =========================================================

RewriteEngine On

# --- Apartamenty całoroczne ---
Redirect 301 /osmioosobowy/ /apartamenty/apartament-1.html
Redirect 301 /piecioosobowy/ /apartamenty/apartament-2.html
Redirect 301 /siedmioosobowy/ /apartamenty/apartament-3.html
Redirect 301 /czteroosobowy/ /apartamenty/apartament-4.html

# --- Apartamenty letnie ---
RewriteRule ^apartamenty-letnie/?$ /index.html#apartamenty-letnie [R=301,L]
Redirect 301 /apa_letni_dwupokojowy/ /apartamenty-letnie/apartament-letni-1.html
Redirect 301 /apa_letni_dwuosobowy/ /apartamenty-letnie/apartament-letni-2.html
Redirect 301 /apa_czarno_bialy/ /apartamenty-letnie/apartament-letni-3.html
Redirect 301 /apa_letni_czteroosobowy/ /apartamenty-letnie/apartament-letni-4.html

# --- Mieszkania letnie ---
Redirect 301 /mieszkania_letnie/ /mieszkania-letnie.html

# --- Pokoje (ogólny przegląd) ---
Redirect 301 /pokoje/ /index.html#apartamenty

# --- Dzieci / atrakcje na miejscu ---
Redirect 301 /sala-zabaw/ /dla-dzieci.html
Redirect 301 /zatoczka-cydrowa/ /dla-dzieci.html
Redirect 301 /atrakcje-w-zatoce-cydrowej/ /index.html#wellness
Redirect 301 /komora-hiperbaryczna-w-zatoce-cydrowej/ /index.html#wellness
Redirect 301 /solarium-w-zatoce-cydrowej/ /index.html#wellness
Redirect 301 /sauna/ /index.html#wellness

# --- Okolica / atrakcje w okolicy ---
Redirect 301 /atrakcje-okolice/ /index.html#okolica

# --- Kontakt / rezerwacje / polityka ---
Redirect 301 /kontakt/ /kontakt.html
Redirect 301 /rezerwacje/ /kontakt.html
Redirect 301 /polityka-prywatnosci/ /polityka-prywatnosci.html

# --- Wpisy blogowe o okolicy (Stegna, Mierzeja Wiślana) ---
# Nowa strona nie ma bloga — przekierowanie do sekcji okolicy zamiast 404.
Redirect 301 /polomarket-stegna/ /index.html#okolica
Redirect 301 /dino-stegna/ /index.html#okolica
Redirect 301 /kosciol-najswietszego-serca-pana-jezusa-w-stegnie/ /index.html#okolica
Redirect 301 /muzeum-stutthof/ /index.html#okolica
Redirect 301 /zimowe-morsowanie/ /index.html#okolica
Redirect 301 /szlak-rowerowy/ /index.html#okolica
Redirect 301 /bursztynowa-komnata/ /index.html#okolica
Redirect 301 /bon-turystyczny/ /index.html#okolica
Redirect 301 /podziel-sie/ /index.html

# HTTPS jest już wymuszany na poziomie panelu Hostingera
# (is_https_redirect_enabled: true) — nie duplikujemy tej reguły tutaj,
# żeby nie tworzyć podwójnego/pętlącego się przekierowania.

# =========================================================
# Kompresja (GZIP/Brotli) — mniejszy transfer HTML/CSS/JS/SVG
# =========================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml application/xml application/xhtml+xml text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/xhtml+xml text/javascript application/javascript application/json image/svg+xml
</IfModule>

# =========================================================
# Cache przeglądarki — obrazy/webp długo, HTML krótko (żeby
# zmiany treści były widoczne od razu, a zdjęcia i style nie
# były pobierane ponownie przy każdej wizycie)
# =========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Podstawowe nagłówki bezpieczeństwa (pomagają też w audytach SEO/PageSpeed)
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
